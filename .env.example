# GitHub commit evidence
GITHUB_EVIDENCE_ENABLED=false
GITHUB_EVIDENCE_OWNER=your-org
GITHUB_EVIDENCE_REPOSITORY=payment-service
GITHUB_TOKEN=

# Loki log evidence
LOKI_EVIDENCE_ENABLED=false
LOKI_BASE_URL=http://localhost:3100/
LOKI_BEARER_TOKEN=
LOKI_TENANT_ID=

# Tempo trace evidence
TEMPO_EVIDENCE_ENABLED=false
TEMPO_BASE_URL=http://localhost:3200/
TEMPO_BEARER_TOKEN=
TEMPO_TENANT_ID=

# Prometheus metric evidence
PROMETHEUS_EVIDENCE_ENABLED=false
PROMETHEUS_BASE_URL=http://localhost:9090/
PROMETHEUS_BEARER_TOKEN=

# Kubernetes deployment evidence
KUBERNETES_EVIDENCE_ENABLED=false
KUBERNETES_BASE_URL=https://kubernetes.default.svc/
KUBERNETES_NAMESPACE=default
KUBERNETES_BEARER_TOKEN=
KUBERNETES_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token

# Optional LLM reasoning
LLM_REASONING_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-5
LLM_API_KEY=
LLM_OPENAI_BASE_URL=https://api.openai.com/
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com/
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# PostgreSQL investigation persistence
PERSISTENCE_ENABLED=true
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=incident_agent;Username=incident_agent;Password=incident_agent
POSTGRES_DB=incident_agent
POSTGRES_USER=incident_agent
POSTGRES_PASSWORD=incident_agent
