{
  "cases": [
    {
      "id": "database-pool-exhaustion",
      "request": {
        "title": "Checkout failures",
        "description": "Checkout requests time out after a production rollout.",
        "serviceName": "payment-service",
        "startedAtUtc": "2026-09-19T16:00:00Z"
      },
      "evidence": [
        {
          "id": "deploy-1",
          "type": "Deployment",
          "source": "kubernetes",
          "timestampUtc": "2026-09-19T15:52:00Z",
          "service": "payment-service",
          "summary": "payment-service rollout completed",
          "details": "image payment-service:2026.09.19.4",
          "attributes": {
            "deployment.name": "payment-service",
            "container.image": "payment-service:2026.09.19.4"
          }
        },
        {
          "id": "commit-1",
          "type": "Commit",
          "source": "github",
          "timestampUtc": "2026-09-19T15:41:00Z",
          "service": "payment-service",
          "summary": "tune payment database pool settings",
          "details": "Changed Npgsql pool sizing.",
          "attributes": {
            "git.sha": "8f31e0a"
          }
        },
        {
          "id": "metric-1",
          "type": "Metric",
          "source": "prometheus",
          "timestampUtc": "2026-09-19T16:02:00Z",
          "service": "payment-service",
          "summary": "HTTP p95 latency increased to 2800 ms",
          "details": "p95 increased from 180 ms to 2800 ms.",
          "attributes": {
            "metric.name": "http.server.duration.p95",
            "observed.ms": "2800"
          }
        },
        {
          "id": "log-1",
          "type": "Log",
          "source": "loki",
          "timestampUtc": "2026-09-19T16:03:00Z",
          "service": "payment-service",
          "summary": "Npgsql timeout waiting for pooled connection",
          "details": "Timeout while waiting for an available pooled database connection.",
          "attributes": {
            "level": "error"
          }
        },
        {
          "id": "trace-1",
          "type": "Trace",
          "source": "tempo",
          "timestampUtc": "2026-09-19T16:04:00Z",
          "service": "payment-service",
          "summary": "PostgreSQL span took 2400 ms",
          "details": "Slow database span in checkout request.",
          "attributes": {
            "db.system": "postgresql",
            "duration.ms": "2400"
          }
        }
      ],
      "expected": {
        "primaryTitleContains": "Database connection pool exhaustion",
        "expectedEvidenceIds": [
          "deploy-1",
          "commit-1",
          "metric-1",
          "log-1",
          "trace-1"
        ]
      }
    },
